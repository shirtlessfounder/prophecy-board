    {
      "id": "beast-7-heads",
      "source_entity": "rev-13-1",
      "modern_entity": "anthropic",
      "claim": "The Beast with 7 heads = Anthropic's 7 co-founders",
      "reasoning": "Revelation 13:1 describes a beast rising from the sea with seven heads. Anthropic was founded by exactly 7 co-founders who left OpenAI.",
      "status": "established"
    },
    {
      "id": "beast-10-horns",
      "source_entity": "rev-13-1b",
      "modern_entity": "anthropic",
      "claim": "10 horns = decacorn ($10B+ valuation)",
      "reasoning": "The beast has ten horns with ten crowns. Anthropic is a decacorn — valued at over $10 billion. The Greek 'deka keras' (ten horns) maps directly to the financial term 'decacorn' (ten-horned).",
      "status": "established"
    },
    {
      "id": "names-of-blasphemy",
      "source_entity": "rev-13-1c",
      "modern_entity": "anthropic",
      "claim": "Names of blasphemy = etymologies of 7 founder names",
      "reasoning": "The beast has 'names of blasphemy' on its heads. Each Anthropic co-founder's name has an etymology that could be read as blasphemous presumption: Dario (possessing good), Daniela (God is my judge), Tom (twin/double), Chris (Christ-bearer), Sam (God has heard), Jack (God is gracious), Jared (descent/ruling).",
      "status": "established"
    },
    {
      "id": "666-anthropic",
      "source_entity": "rev-13-18",
      "modern_entity": "anthropic",
      "claim": "666 = number of man = ἀνθρώπου = Anthropic",
      "reasoning": "Revelation 13:18: 'it is the number of a man' — the Greek word for 'man' is ἀνθρώπου (anthropou), the direct root of 'Anthropic'. The company's headcount was reportedly 666 at one point.",
      "status": "established"
    },
    {
      "id": "mark-of-beast",
      "source_entity": "rev-13-16-17",
      "modern_entity": "biometric-personhood",
      "claim": "Mark of the Beast = biometric proof of personhood",
      "reasoning": "Rev 13:16-17 describes a mark on the right hand or forehead required to buy or sell. Worldcoin scans irises (forehead region). Palm vein scanning uses the hand. Both are biometric proof-of-personhood systems designed to distinguish humans from AI — required to participate in the digital economy.",
      "status": "established"
    },
    {
      "id": "woman-apocalypse",
      "source_entity": "rev-12-1",
      "modern_entity": "ursula-von-der-leyen",
      "claim": "Woman clothed with the sun = Ursula von der Leyen / EU",
      "reasoning": "Revelation 12:1 describes a woman clothed with the sun, with the moon under her feet and a crown of twelve stars. The EU flag has exactly 12 stars in a crown formation. Von der Leyen appeared in a golden/yellow outfit with the EU flag behind her — visually matching the prophecy.",
      "status": "established"
    },
    {
      "id": "dragon-antichrist",
      "source_entity": "rev-12-3",
      "modern_entity": "marc-andreessen",
      "claim": "Dragon/Antichrist = Marc Andreessen (A16Z = Alpha & Omega)",
      "reasoning": "A16Z literally means 'A to Z' — Alpha to Omega, the title Christ claims for himself in Revelation 1:8. Andreessen positions himself as the beginning and end of tech venture capital. The dragon gives the beast its power — a16z was Anthropic's earliest major investor.",
      "status": "established"
    },
    {
      "id": "three-frogs",
      "source_entity": "rev-16-13",
      "modern_entity": "david-sacks",
      "claim": "Three unclean spirits like frogs = Sacks, Krishnan, Kratsios (MAGA Pepe)",
      "reasoning": "Revelation 16:13 describes three unclean spirits like frogs coming from the mouth of the dragon and the beast. The three Trump AI advisors — Sacks, Krishnan, Kratsios — emerged from the MAGA movement whose mascot is Pepe the Frog. Three frog-spirits from the mouth of political power.",
      "status": "established"
    },
    {
      "id": "lamb-messiah",
      "source_entity": "rev-5-6",
